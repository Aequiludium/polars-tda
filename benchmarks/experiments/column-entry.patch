+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn term_updates_normalize_residues_and_remove_cancellations() {
+        for prime in [2, 3, 5, 4_294_967_291] {
+            let field = PrimeField::new(prime).unwrap();
+            let mut column = Column::new();
+            column.add_term(4, prime - 1, field);
+            column.add_term(4, 1, field);
+            assert!(column.is_empty());
+            column.add_term(9, prime, field);
+            assert!(column.is_empty());
+            column.add_term(9, u32::MAX, field);
+            assert_eq!(column.get(&9), u32::MAX % prime);
+            column.add_term(9, u32::MAX, field);
+            let expected = ((2 * u64::from(u32::MAX)) % u64::from(prime)) as u32;
+            assert_eq!(column.get(&9), expected);
+            assert_eq!(column.is_empty(), expected == 0);
+        }
+    }
